# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
!.env.example

# Data (raw/derived video and pose artifacts are large and not committed)
data/raw/*
data/trimmed/*
data/pose_raw/*
data/phase_boundaries_raw/*
data/phase_boundaries_gold/*
data/features_raw/*
data/landmarks_raw/*
data/pose_overlay_debug/*
data/uploads/*
# Unreviewed candidate downloads (pipeline/run_candidate_download.py) --
# copyrighted source video, staged for frame-by-frame QC before anything
# from here is promoted into data/raw/ + provenance.csv per data_criteria.md.
data/candidates_staging/*
# ffmpeg-trimmed reference clips cached for GET /reference-clips/{id}/video
# (api/main.py::_boundary_trimmed_reference_video) -- derived from copyrighted
# source video, regenerable from data/trimmed/, never committed.
data/served_clips/*
!data/**/.gitkeep

# Model weights / checkpoints
*.onnx
*.pt
*.pth
*.ckpt
*.task
models/checkpoints/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local state (agent worktrees, local settings)
.claude/
