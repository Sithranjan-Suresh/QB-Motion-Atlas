# Copy to .env for local dev. In production set these in the host's
# settings (Hugging Face Space: Settings -> Variables and secrets).

# --- Required ---------------------------------------------------------------
# Any postgres:// / postgresql:// URL works (the psycopg2 driver is added
# automatically). Supabase: use the *Session pooler* string (IPv4), not the
# direct db.<ref>.supabase.co host (IPv6-only). URL-encode special
# characters in the password (@ -> %40).
DATABASE_URL=postgresql://qb_motion_atlas:changeme@localhost:5432/qb_motion_atlas

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Video storage (unset S3_BUCKET = local disk under data/) ---------------
# Supabase Storage: endpoint https://<ref>.storage.supabase.co/storage/v1/s3
# Cloudflare R2:    endpoint https://<account-id>.r2.cloudflarestorage.com, region auto
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# redirect (default): 302 to a signed URL. proxy: stream through the API.
S3_SERVE_MODE=redirect

# --- Coaching notes (unset = rule-based notes only) --------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Jobs ---------------------------------------------------------------------
# worker (default): background threads in the API process. inline: run right
# after the request (tests). none: run `python -m api.worker` separately.
JOB_RUNNER=worker
WORKER_CONCURRENCY=1
JOB_TIMEOUT_SEC=300
JOB_MAX_ATTEMPTS=3
MAX_QUEUED_UPLOADS=20

# --- Abuse / privacy ----------------------------------------------------------
UPLOAD_RATE_LIMIT_COUNT=10
UPLOAD_RATE_LIMIT_WINDOW_SEC=3600
UPLOAD_RETENTION_DAYS=7
# false = use the socket peer address instead of X-Forwarded-For.
TRUST_PROXY_HEADERS=true

# --- Reference video ----------------------------------------------------------
# false = skeleton-only for every reference clip (takedown kill-switch).
REFERENCE_VIDEO_OVERLAY_ENABLED=true
# false = skeleton-only for official league/team broadcast clips.
REFERENCE_VIDEO_ALLOW_OFFICIAL=true

# --- Model / observability ------------------------------------------------------
# Directory with one trained ONNX checkpoint per phase (optional).
EMBEDDING_CHECKPOINTS_DIR=
SENTRY_DSN=
LOG_FORMAT=json
LOG_LEVEL=INFO
